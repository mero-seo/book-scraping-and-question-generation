# MongoDB (Atlas or local)
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/?appName=MyApp
MONGODB_DB=book_db

# OpenRouter (free tier — sign up at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Ollama (cloud models as LLM fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-v3.1:671b-cloud

# Pinecone (free tier — sign up at https://www.pinecone.io)
# Create an index: dimension=1024, metric=cosine
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# JWT
JWT_SECRET=change-this-to-a-random-secret

# Cloudflare R2 (optional — for PDF uploads)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=book-pdfs

# CORS
CORS_ORIGIN=http://localhost:3000
